// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
 }

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  phone         String?
  password_hash String
  role          String
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  deleted_at    DateTime?

  sales_cancelled Sale[]   @relation("SaleCancelledBy")
  stock_movements StockMovement[]
  audit_logs      AuditLog[]
  cash_sessions   CashSession[]
}

model Product {
  id              Int      @id @default(autoincrement())
  name            String
  sku             String?   @unique
  buy_price       Float     @default(0)
  sell_price      Float     @default(0)
  stock_qty       Int       @default(0)
  alert_threshold Int       @default(0)
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  sale_items      SaleItem[]
  stock_movements StockMovement[]

  @@check(stock_qty >= 0)
  @@check(sell_price >= 0)
}

model CashSession {
  id              Int       @id @default(autoincrement())
  user_id         Int
  opened_at       DateTime  @default(now())
  closed_at       DateTime?
  opening_float   Float     @default(0)
  closing_counted Float?
  status          String

  user            User      @relation(fields: [user_id], references: [id])
  sales           Sale[]
}

model Sale {
  id                Int      @id @default(autoincrement())
  session_id        Int
  total             Float
  amount_received   Float
  change_given      Float
  payment_method    String
  status            String
  cancelled_by      Int?
  cancel_reason     String?
  idempotency_key   String   @unique
  created_at        DateTime @default(now())

  session          CashSession @relation(fields: [session_id], references: [id])
  items            SaleItem[]
  cancelled_by_user User? @relation("SaleCancelledBy", fields: [cancelled_by], references: [id])
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  sale_id       Int
  product_id    Int
  product_name  String
  qty           Int
  unit_price    Float
  discount      Float   @default(0)

  sale          Sale    @relation(fields: [sale_id], references: [id])
  product       Product @relation(fields: [product_id], references: [id])
}